# Copy to .env (git-ignored) or set in Vercel → Project → Settings → Environment Variables.

# ── Storage ────────────────────────────────────────────────────────────────
# Upstash Redis (REST). Leave unset to use a local file (.data/store.db).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Namespace for every key, so several datasets can share one database.
STORE_PREFIX=map:
# Local file store location (only when Redis is not configured).
# STORE_PATH=.data/store.db

# ── Demo mode ──────────────────────────────────────────────────────────────
# 1 = read-only: edits, refresh buttons and on-demand Yahoo downloads are disabled.
DEMO_MODE=
# Shared secret for /api/cron/refresh (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Seconds the cron job may spend before it stops starting new downloads.
# CRON_BUDGET_SECONDS=270
# Shown in the demo banner as "Run your own copy".
REPO_URL=

# ── Interactive Brokers (optional, local use) ──────────────────────────────
# See docs/ibkr-setup.md. Disabled in demo mode.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_BASE_CURRENCY=GBP
