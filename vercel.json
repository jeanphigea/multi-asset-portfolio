{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{templates,static,data}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 6 * * 1-5"
    }
  ]
}
